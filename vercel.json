{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @memories/ui -- --base=/app/ && node scripts/prepare-vercel.mjs",
  "outputDirectory": "packages/ui/dist",
  "framework": null,
  "build": {
    "env": {
      "VITE_MEMORIES_DEMO": "true",
      "VITE_DEMO_AUTH": "true"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ]
}
