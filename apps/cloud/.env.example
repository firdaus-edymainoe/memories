# Memories cloud server. Copy to .env and fill in. Never commit real secrets.

# Public URL of this server (what the desktop app and OAuth providers call back to).
BETTER_AUTH_URL=http://localhost:8787
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgres://memories:memories@localhost:5432/memories
PORT=8787
# Refuse password sign-in until the email is confirmed.
REQUIRE_EMAIL_VERIFICATION=false

# Email (verification and password reset). Without a key, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Memories <hello@example.com>

# Cloud storage. backblaze-b2 (default), aws-s3, cloudflare-r2, s3-compatible or memory.
STORAGE_PROVIDER=backblaze-b2
STORAGE_BUCKET=memories-files
# B2: an application key limited to this bucket. keyID → ACCESS_KEY_ID, applicationKey → SECRET.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# B2 and AWS: the region in the bucket's S3 endpoint, e.g. us-west-004.
STORAGE_REGION=us-west-004
# cloudflare-r2 only:
# STORAGE_ACCOUNT_ID=
# s3-compatible only (MinIO, Wasabi, …):
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_FORCE_PATH_STYLE=true

# People's own drives: set an id and secret to let people connect theirs. Each person can connect
# several. Redirect URI for both: <BETTER_AUTH_URL>/drives/callback
# Google Drive: a Google Cloud OAuth client (web) with the Drive API on; scope drive.file.
# It can be the same client as Google sign-in, with the extra redirect URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# OneDrive: a Microsoft Entra app (personal and work accounts) with Files.ReadWrite.AppFolder,
# User.Read and offline_access.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common

# Sign-in providers: set an id and secret to turn one on. Redirect URI for each:
#   <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
